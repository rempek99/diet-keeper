# Copy to .env and fill in real values. Never commit .env.

# Postgres container (docker-compose.yaml)
POSTGRES_USER=DB_USER
POSTGRES_PASSWORD=DB_PASSWORD
POSTGRES_DB=DB_NAME

# Prisma: must match the POSTGRES_* values above (URL-encode special characters in the password)
DATABASE_URL="postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME?schema=public"

# Auth: at least 32 bytes. Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_ME

# First SuperAdmin account, created by the seed script
SUPERADMIN_USERNAME=admin
SUPERADMIN_PASSWORD=CHANGE_ME
